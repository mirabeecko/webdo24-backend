# POZNÁMKA: Toto je referenční kopie produkční konfigurace.
# Skutečný běžný config je na VPS (188.245.67.17) v /etc/caddy/Caddyfile
# a obsahuje i další služby (n8n, api, grafana, ...).
#
# login.webdo24.cz — zákaznická/admin aplikace — běží na VERCELU
# (DNS míří přímo na Vercel, Caddy ji neobsluhuje).
#
# web.webdo24.cz — veřejné weby zákazníků — DNS míří na VPS a Caddy
# proxyguje na renderer v aplikaci na Vercelu (Host override).
# Deployováno 2026-08-09 (Customer Control Center, Phase 4).

web.webdo24.cz {
    # Customer Control Center renderer (Next.js na Vercelu)
    reverse_proxy https://login.webdo24.cz {
        header_up Host login.webdo24.cz
    }

    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        # povolit iframe preview z dashboardu a marketingového webu
        Content-Security-Policy "frame-ancestors 'self' https://login.webdo24.cz https://webdo24.cz https://*.webdo24.cz"
        Referrer-Policy strict-origin-when-cross-origin
    }
}
